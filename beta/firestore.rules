rules_version = '2';

/* Правила доступа к бюджету.

   Смысл: данные хозяйства видит и правит только тот, чья почта есть в
   memberEmails этого хозяйства. Проверяет это сервер Firestore — обойти из
   браузера нельзя. Список участников меняет только владелец.

   Куда вставить: Firebase Console → Firestore Database → вкладка Rules →
   заменить всё содержимое этим текстом → Publish.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // почта берётся из токена и только если она подтверждена
    // (вход по ссылке из письма подтверждает её автоматически)
    function mail() {
      return (request.auth != null && request.auth.token.email_verified == true)
        ? request.auth.token.email : null;
    }
    function hh(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }
    function isMember(hid) {
      return mail() != null && mail() in hh(hid).memberEmails;
    }
    function isOwner(hid) {
      return mail() != null && mail() == hh(hid).ownerEmail;
    }

    // По какой почте — в какое хозяйство. Читать может только владелец почты.
    match /invites/{email} {
      allow read:          if mail() == email;
      allow create, update: if isOwner(request.resource.data.hid);
      allow delete:         if isOwner(resource.data.hid);
    }

    match /households/{hid} {
      // создать хозяйство можно только на себя и только с собой в участниках
      allow create: if mail() != null
                    && request.resource.data.ownerEmail == mail()
                    && request.resource.data.memberEmails.hasOnly([mail()]);

      // get несуществующего документа разрешён любому вошедшему: первый вход
      // владельца читает свой будущий hid ДО создания — иначе deny ломает онбординг.
      // Существующие документы читают только участники. list запрещён всегда.
      allow get:  if (mail() != null
                      && !exists(/databases/$(database)/documents/households/$(hid)))
                     || isMember(hid);
      allow list: if false;

      // участник правит данные, но не может ни сменить владельца,
      // ни отредактировать список участников — это только владелец
      allow update: if isMember(hid)
                    && request.resource.data.ownerEmail == resource.data.ownerEmail
                    && (isOwner(hid)
                        || request.resource.data.memberEmails == resource.data.memberEmails);

      allow delete: if isOwner(hid);

      match /months/{ym}  { allow read, write: if isMember(hid); }
      match /lists/{name} { allow read, write: if isMember(hid); }
    }

    // всё остальное закрыто
    match /{document=**} { allow read, write: if false; }
  }
}
